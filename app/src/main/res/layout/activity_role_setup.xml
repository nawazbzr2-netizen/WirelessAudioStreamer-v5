<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_sender"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_receiver"
                android:textSize="16sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name"
            android:inputType="text"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN (4–8 نمبر)"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginTop="8dp" />

        <GridLayout
            android:id="@+id/pinPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignBounds"
            android:layout_marginTop="12dp">

            <Button android:id="@+id/pin1" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="1" android:layout_margin="4dp" />
            <Button android:id="@+id/pin2" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="2" android:layout_margin="4dp" />
            <Button android:id="@+id/pin3" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="3" android:layout_margin="4dp" />

            <Button android:id="@+id/pin4" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="4" android:layout_margin="4dp" />
            <Button android:id="@+id/pin5" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="5" android:layout_margin="4dp" />
            <Button android:id="@+id/pin6" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="6" android:layout_margin="4dp" />

            <Button android:id="@+id/pin7" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="7" android:layout_margin="4dp" />
            <Button android:id="@+id/pin8" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="8" android:layout_margin="4dp" />
            <Button android:id="@+id/pin9" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="9" android:layout_margin="4dp" />

            <Button android:id="@+id/pinOk" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="✓" android:layout_margin="4dp" />
            <Button android:id="@+id/pin0" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="0" android:layout_margin="4dp" />
            <Button android:id="@+id/pinDel" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_columnWeight="1" android:text="⌫" android:layout_margin="4dp" />
        </GridLayout>

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_continue"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
